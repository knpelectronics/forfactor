import BaseLayout from '../../layouts/BaseLayout.astro';import PageHero from '../../components/PageHero.astro';
const breadcrumb={"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.forfactor.com/"},{"@type":"ListItem","position":2,"name":"Products","item":"https://www.forfactor.com/products/"},{"@type":"ListItem","position":3,"name":"Keenout","item":"https://www.forfactor.com/products/keenout/"}]};
---
<BaseLayout title="Keenout — Discover events, meet people and make plans" description="Keenout is an activity-first social platform for discovering local events, meeting people through shared interests and making real-life plans." structuredData={breadcrumb}><PageHero eyebrow="Forfactor product · Social discovery" title="Discover events, meet people, and make plans." intro="Keenout is an activity-first social platform that helps people find things to do and turn shared interests into real-world connection." crumbs={[["Home","/"],["Products","/products/"],["Keenout","/products/keenout/"]]}/>
<section class="section"><div class="shell prose-grid"><p class="eyebrow">What it is</p><div class="prose"><h2>A social platform built around doing.</h2><p>Keenout starts with activities rather than profiles. People can discover local events and social plans, connect through shared interests, and make plans to meet in real life. It is not a dating app.</p><p>The aim is simple: make it easier to find something worth doing and people who are keen to join.</p><p><a class="button" href="https://keenout.com.au">Explore Keenout's official website ↗</a></p></div></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><p class="eyebrow">How Keenout works</p><div><h2>From discovery to a real plan.</h2><p>Explore what's happening, connect around an activity, then take the plan into the real world.</p></div></div><div class="steps"><div class="step"><h3>Discover events</h3><p>Find local events and activities that match what you feel like doing.</p></div><div class="step"><h3>Meet through interests</h3><p>Connect with people around a shared activity or idea.</p></div><div class="step"><h3>Create or join plans</h3><p>Start a plan of your own or join one that already sounds good.</p></div><div class="step"><h3>Tools for organisers</h3><p>Help people find activities and bring interested communities together.</p></div></div></div></section>
<section class="section"><div class="shell cta"><h2>Find your next plan.</h2><a class="button" href="https://keenout.com.au">Discover events on Keenout ↗</a></div></section></BaseLayout>
