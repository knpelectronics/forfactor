---
import BaseLayout from '../layouts/BaseLayout.astro';import ProductCard from '../components/ProductCard.astro';
---
<BaseLayout title="Forfactor" description="Forfactor is an Australian technology company building useful digital products for people and businesses.">
<section class="hero"><div class="shell hero-grid reveal"><div><p class="eyebrow">Australian technology company</p><h1>Useful technology. <span>Built with intent.</span></h1><p class="lede">Forfactor builds and operates digital products that help people discover, connect, learn and get things done.</p><div class="hero-actions"><a class="button" href="/products/">Explore our products <span aria-hidden="true">↗</span></a><a class="button secondary" href="/about/">Meet Forfactor</a></div></div><div class="orbit" aria-hidden="true"><span class="orbit-label">Ideas · Systems · Products · Progress</span></div></div></section>
<section class="section"><div class="shell"><div class="section-head"><p class="eyebrow">What we build</p><div><h2>Products for life beyond the screen.</h2><p>We focus on clear human needs, then use thoughtful technology to make the experience simpler.</p></div></div><div class="product-grid"><ProductCard number="01 / SOCIAL" name="Keenout" description="Discover local events, meet people and make real-life plans." href="/products/keenout/" featured/><ProductCard number="02 / BUSINESS" name="Heela" description="An AI-powered phone receptionist platform for businesses." href="/products/heela/" status="In development"/><ProductCard number="03 / LEARNING" name="Pronovo" description="Accessible language learning built around consistent practice." href="/products/pronovo/"/></div></div></section>
<section class="section alt"><div class="shell"><div class="section-head"><p class="eyebrow">How we think</p><div><h2>Technology should earn its place.</h2><p>Our work starts with usefulness. We favour focused products, calm interfaces and systems designed to last.</p></div></div><div class="principles"><div class="principle"><span class="eyebrow">01</span><h3>Human outcomes</h3><p>We begin with the progress people and businesses are trying to make.</p></div><div class="principle"><span class="eyebrow">02</span><h3>Clear by design</h3><p>Every interaction should feel considered, understandable and direct.</p></div><div class="principle"><span class="eyebrow">03</span><h3>Built responsibly</h3><p>We choose practical technology and build with care for reliability and trust.</p></div></div></div></section>
<section class="section"><div class="shell"><div class="prose-grid"><p class="eyebrow">Featured product</p><div class="prose"><h2>Turn “we should do something” into a real plan.</h2><p>Keenout is an activity-first social platform for discovering events, finding people with shared interests and making plans in the real world.</p><p><a class="button" href="https://keenout.com.au">Discover events and make plans on Keenout ↗</a></p></div></div></div></section>
<section class="section tight"><div class="shell cta"><h2>Have something to discuss?</h2><a class="button" href="mailto:hello@forfactor.com">hello@forfactor.com ↗</a></div></section>
</BaseLayout>
